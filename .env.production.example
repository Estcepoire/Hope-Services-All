# Copier en .env.production sur le serveur, puis remplir. Ne jamais committer le vrai fichier.
# Générer chaque secret avec : openssl rand -base64 32

# Domaines (doivent pointer vers l'IP publique du serveur)
# Sans nom de domaine : utiliser sslip.io, ex. APP_DOMAIN=141.145.1.2.sslip.io et AUTH_DOMAIN=auth.141.145.1.2.sslip.io
APP_DOMAIN=hopeservices.mg
AUTH_DOMAIN=auth.hopeservices.mg

# Base de données
POSTGRES_USER=hope
POSTGRES_PASSWORD=

# Auth.js
AUTH_SECRET=

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=

# Connexion Google (facultatif, voir README)
AUTH_GOOGLE_ENABLED=false
