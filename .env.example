# Copier ce fichier en .env puis adapter.
# Base locale lancée par docker-compose.yml (identifiants de développement uniquement)
DATABASE_URL="postgresql://hope:hope@localhost:5432/hope_services?schema=public"

# Auth.js + Keycloak (voir docker-compose.yml et docker/keycloak/hope-realm.json)
# Générer AUTH_SECRET avec : npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_KEYCLOAK_ID="hope-web"
AUTH_KEYCLOAK_SECRET="hope-web-dev-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/hope"

# Connexion Google via Keycloak (facultatif) : voir README, section « Connexion avec Google »
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Affiche le bouton « Continuer avec Google » une fois Google configuré dans Keycloak
AUTH_GOOGLE_ENABLED="false"
